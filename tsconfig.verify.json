{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "outDir": ".tmp-verify",
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": [
    "scripts/verify-dataset.ts",
    "scripts/verify-scenarios.ts",
    "lib/sim/**/*.ts",
    "lib/sql/**/*.ts",
    "lib/scenarios/**/*.ts",
    "lib/stripe-sim/**/*.ts"
  ],
  "exclude": ["lib/store/**"]
}
